# Placeholder values only. Do not commit a populated .env file.
KIS_MOCK_APP_KEY=<REPLACE_ME>
KIS_MOCK_APP_SECRET=<REPLACE_ME>
KIS_MOCK_ACCOUNT_NO=<REPLACE_ME>
REDIS_URL=<REPLACE_ME>

# Static Alpaca paper-crypto credentials. These names are only used for the
# alpaca_paper_crypto account scope; no Alpaca live hostname is configurable.
ALPACA_PAPER_CRYPTO_API_KEY=<REPLACE_ME>
ALPACA_PAPER_CRYPTO_API_SECRET=<REPLACE_ME>

# Local kis-mock-edge settings. Placement remains disabled unless explicitly
# set to true; these defaults never enable a network placement.
BROKER_EDGE_MOCK_PLACE_ENABLED=false
BROKER_EDGE_LISTEN_ADDR=127.0.0.1:8080
BROKER_EDGE_SQLITE_PATH=kis-mock-edge.sqlite
