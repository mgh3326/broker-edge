[Unit]
Description=broker-edge kis-mock-edge container (digest pinned)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
# STATE_DIR and the --env-file path are host-specific placeholders.
Environment=STATE_DIR=/var/lib/broker-edge
EnvironmentFile=${STATE_DIR}/broker-edge.service.image
ExecStartPre=-/usr/bin/docker rm -f broker-edge
ExecStart=/usr/bin/docker run --rm --name broker-edge --network host --env-file /etc/broker-edge/PLACEHOLDER.env --volume /var/lib/broker-edge:/var/lib/broker-edge:rw ${IMAGE} kis-mock-edge
ExecStop=/usr/bin/docker stop --time 30 broker-edge
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
